<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="caja-historial" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.HistorialVentasController">
   <children>

      <!-- Cabecera -->
      <HBox alignment="TOP_LEFT" spacing="12.0">
         <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="texto-secundario" text="Inicio › Caja y pedidos › Historial de ventas" />
                  <Label styleClass="titulo" text="Historial de ventas" />
               </children>
            </VBox>
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volver" styleClass="caja-btn-pill" text="← Volver a caja" />
         </children>
      </HBox>

      <!-- Filtros -->
      <HBox alignment="BOTTOM_LEFT" spacing="12.0" styleClass="tarjeta">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="caja-filtro-label" text="Desde" />
                  <DatePicker fx:id="dpDesde" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="caja-filtro-label" text="Hasta" />
                  <DatePicker fx:id="dpHasta" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="caja-filtro-label" text="Buscar" />
                  <TextField fx:id="txtBuscar" maxWidth="Infinity" promptText="Nº de pedido o camarero" />
               </children>
            </VBox>
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarFiltros" styleClass="btn-secundario" text="Limpiar" />
         </children>
      </HBox>

      <!-- Tabla (columnas enlazadas desde el controlador) -->
      <TableView fx:id="tablaVentas" styleClass="caja-tabla" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="colNumero" text="Nº pedido" />
            <TableColumn fx:id="colFecha" text="Fecha y hora" />
            <TableColumn fx:id="colEmpleado" text="Camarero" />
            <TableColumn fx:id="colTipo" text="Tipo" />
            <TableColumn fx:id="colTotal" text="Total" />
            <TableColumn fx:id="colEstado" text="Estado" />
         </columns>
         <placeholder>
            <Label styleClass="texto-secundario" text="No hay ventas en este rango" />
         </placeholder>
      </TableView>

      <!-- Pie -->
      <HBox alignment="CENTER_RIGHT" spacing="24.0" styleClass="caja-historial-pie">
         <children>
            <Label fx:id="lblNumVentas" styleClass="texto-secundario" text="0 ventas" />
            <Label styleClass="caja-total-texto" text="Total vendido" />
            <Label fx:id="lblTotalVendido" styleClass="caja-total" text="0,00 €" />
         </children>
      </HBox>
   </children>
</VBox>
