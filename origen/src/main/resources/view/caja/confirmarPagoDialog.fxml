<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="340.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ConfirmarPagoDialogController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <Label text="Total a pagar" />
    <Label fx:id="lblTotal" text="0,00 €" style="-fx-font-size: 28px; -fx-font-weight: bold;" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Método de pago:" />
        <ComboBox fx:id="cmbMetodoPago" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnVolver" text="Volver" onAction="#volver" cancelButton="true" />
        <Button fx:id="btnPagar" text="Pagar" onAction="#onPagar" defaultButton="true" />
    </HBox>
</VBox>