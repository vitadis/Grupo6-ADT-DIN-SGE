<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="340.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ConfirmarPagoDialogController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="titulo" text="Total a pagar" />
    <Label fx:id="lblTotal" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="0,00 €" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Método de pago:" />
        <ComboBox fx:id="cmbMetodoPago" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnVolver" cancelButton="true" onAction="#volver" styleClass="btn-secundario" text="Volver" />
        <Button fx:id="btnPagar" onAction="#onPagar" styleClass="btn-primario" text="Pagar" />
    </HBox>
</VBox>
