<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="caja-registro" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RegistroPedidoController">
   <children>
      <VBox spacing="10.0" styleClass="caja-resumen">
         <children>

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="texto-secundario" text="Productos" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblNumProductos" styleClass="caja-resumen-valor" text="0" />
               </children>
            </HBox>

            <Label styleClass="texto-secundario" text="IVA incluido" />

            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="caja-total-texto" text="Total" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblTotal" styleClass="caja-total" text="0,00 €" />
               </children>
            </HBox>

            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btnCancelar" minWidth="110.0" mnemonicParsing="false" onAction="#cancelar" styleClass="caja-btn-cancelar" text="Cancelar" />
                  <Button fx:id="btnCobrar" maxWidth="Infinity" mnemonicParsing="false" onAction="#cobrar" styleClass="btn-primario caja-btn-cobrar" text="Cobrar 0,00 €" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <Label alignment="CENTER" maxWidth="Infinity" styleClass="texto-secundario" text="Elimina líneas con ✕ · Cantidad con − / +" />
         </children>
      </VBox>
   </children>
</VBox>
