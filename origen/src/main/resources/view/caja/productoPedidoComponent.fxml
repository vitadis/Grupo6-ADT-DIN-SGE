<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProductoPedidoComponentController">
    <children>
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblNombre" text="Producto" />
                <Label fx:id="lblPrecioUnidad" text="0,00 € / ud." />
            </children>
        </VBox>
        <HBox alignment="CENTER" spacing="4.0">
            <children>
                <Button mnemonicParsing="false" onAction="#restar" text="-" />
                <Label fx:id="lblCantidad" text="1" />
                <Button fx:id="btnMas" mnemonicParsing="false" onAction="#sumar" text="+" />
            </children>
        </HBox>
        <Label fx:id="lblSubtotal" minWidth="64.0" text="0,00 €" />
        <Button mnemonicParsing="false" onAction="#quitar" text="✕" />
    </children>
</HBox>
