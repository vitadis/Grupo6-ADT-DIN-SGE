<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="8.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProductoPedidoComponentController">
    <children>
        <VBox minWidth="0.0" spacing="2.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblNombre" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="pedido-nombre" text="Producto" />
                <Label fx:id="lblPrecioUnidad" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="texto-secundario" text="0,00 € / ud." />
            </children>
        </VBox>

        <HBox alignment="CENTER" minWidth="100.0" spacing="4.0" styleClass="pedido-cantidad-box">
            <children>
                <Button minWidth="28.0" mnemonicParsing="false" onAction="#restar" styleClass="pedido-btn-cantidad" text="-" />
                <Label fx:id="lblCantidad" minWidth="22.0" styleClass="pedido-cantidad" text="1" />
                <Button fx:id="btnMas" minWidth="28.0" mnemonicParsing="false" onAction="#sumar" styleClass="pedido-btn-cantidad" text="+" />
            </children>
        </HBox>

        <Label fx:id="lblSubtotal" minWidth="72.0" styleClass="pedido-subtotal" text="0,00 €" />
        <Button minWidth="36.0" mnemonicParsing="false" onAction="#quitar" prefHeight="28.0" prefWidth="36.0" styleClass="pedido-btn-quitar" text="✕" />
    </children>
</HBox>