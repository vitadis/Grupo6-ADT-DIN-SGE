<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="caja-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CajaController">

    <fx:define>
        <ToggleGroup fx:id="grupoCategorias" />
    </fx:define>

    <children>
        <HBox fx:id="contenidoCaja" spacing="24.0">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="TOP_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="titulo" text="Caja y pedidos" />
                                        <Label fx:id="lblSubtituloPedido" styleClass="texto-secundario" text="Pedido nº · Mostrador · Turno de" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnHistorial" mnemonicParsing="false" onAction="#mostrarHistorial" styleClass="caja-btn-pill" text="Historial de ventas" />
                            </children>
                        </HBox>

                        <FlowPane fx:id="boxCategorias" hgap="8.0" vgap="8.0">
                            <children>
                                <RadioButton fx:id="rbTodo" mnemonicParsing="false" selected="true" styleClass="caja-chip" text="Todo">
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoCategorias" />
                           </toggleGroup></RadioButton>
                            </children>
                        </FlowPane>

                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="caja-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="gridProductos" hgap="12.0" styleClass="caja-grid" vgap="12.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <VBox fx:id="panelPedido" maxWidth="360.0" minWidth="320.0" prefWidth="340.0" styleClass="tarjeta caja-panel-pedido">
                    <children>
                        <fx:include fx:id="listaCompra" source="listaCompraComponent.fxml" VBox.vgrow="ALWAYS" />
                        <fx:include fx:id="registroPedido" source="registroPedidoComponent.fxml" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <StackPane fx:id="capaHistorial" managed="false" styleClass="caja-capa-historial" visible="false">
            <children>
                <fx:include fx:id="historialVentas" source="historialVentasComponent.fxml" />
            </children>
        </StackPane>
    </children>
</StackPane>
