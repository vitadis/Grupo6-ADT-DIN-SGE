<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="caja-lista" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ListaCompraController">
   <children>

      <!-- Cabecera -->
      <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="caja-lista-cabecera">
         <children>
            <Label styleClass="subtitulo" text="Pedido actual" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTipoPedido" styleClass="caja-badge" text="Mostrador" />
         </children>
      </HBox>

      <!-- Líneas del pedido (se añaden desde el controlador) -->
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="caja-scroll">
               <content>
                  <VBox fx:id="listaLineas" styleClass="caja-lineas" />
               </content>
            </ScrollPane>
            <Label fx:id="lblVacio" alignment="CENTER" mouseTransparent="true" styleClass="texto-secundario" text="Añade productos para empezar el pedido" textAlignment="CENTER" wrapText="true" />
         </children>
      </StackPane>
   </children>
</VBox>
