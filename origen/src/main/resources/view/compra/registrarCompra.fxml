<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana para registrar una compra (también sirve para "Crear compra con esta lista") -->
<VBox prefHeight="640" prefWidth="720" spacing="16" styleClass="ventana" stylesheets="@../../css/theme.css, @../../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegistrarCompraController">
    <padding>
        <Insets bottom="24" left="28" right="28" top="24" />
    </padding>

    <Label fx:id="lblTitulo" styleClass="tituloVentana" text="REGISTRAR COMPRA" />

    <!-- Cabecera de la compra -->
    <Label styleClass="subtitulo" text="Datos de la compra" />
    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Proveedor *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbProveedor" maxWidth="Infinity" promptText="Selecciona un proveedor" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Fecha *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Nº de factura *" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtNumeroFactura" promptText="F-2026-0000" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <!-- Añadir una línea -->
    <Label styleClass="subtitulo" text="Productos" />
    <HBox alignment="CENTER_LEFT" spacing="10">
        <ComboBox fx:id="cbProducto" prefWidth="240" promptText="Producto" />
        <TextField fx:id="txtCantidad" prefWidth="90" promptText="Cantidad" />
        <TextField fx:id="txtPrecioUnidad" prefWidth="110" promptText="Precio unidad" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnAnadirLinea" onAction="#onAnadirLinea" styleClass="btn-secundario" text="+ Añadir" />
    </HBox>

    <!-- Líneas añadidas -->
    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="compras-tabla-cabecera">
            <Label prefWidth="220" styleClass="texto-secundario" text="Producto" />
            <Label prefWidth="80" styleClass="texto-secundario" text="Cantidad" />
            <Label prefWidth="100" styleClass="texto-secundario" text="Precio unidad" />
            <Label prefWidth="60" styleClass="texto-secundario" text="IVA" />
            <Label prefWidth="100" styleClass="texto-secundario" text="Subtotal" />
            <Label prefWidth="40" />
        </HBox>

        <ScrollPane fx:id="scrollLineas" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <VBox fx:id="contenedorLineas" spacing="4" styleClass="compras-lista-filas" />
        </ScrollPane>
    </VBox>

    <!-- Totales -->
    <HBox alignment="CENTER_RIGHT" spacing="24">
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label styleClass="texto-secundario" text="Base" />
            <Label fx:id="lblBase" text="0,00 €" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label styleClass="texto-secundario" text="IVA" />
            <Label fx:id="lblTotalIva" text="0,00 €" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label styleClass="texto-secundario" text="Total" />
            <Label fx:id="lblTotal" styleClass="compra-dato-destacado" text="0,00 €" />
        </VBox>
    </HBox>

    <!-- Mensaje de error de validación (vacío hasta que haga falta) -->
    <Label fx:id="lblError" styleClass="texto-error" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="btn-secundario" text="Cancelar" />
        <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="btnPrimario" text="Guardar compra" />
    </HBox>
</VBox>
