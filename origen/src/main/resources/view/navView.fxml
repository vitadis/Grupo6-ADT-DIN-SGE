<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="450.0" minWidth="700.0" prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.NavController">

    <left>
        <VBox fx:id="vbContenido" fillWidth="true" maxWidth="280.0" minWidth="230.0" prefWidth="240.0" spacing="8.0" styleClass="sidebar">
            <padding>
                <Insets bottom="16.0" left="12.0" right="12.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER" prefHeight="72.0">
                    <children>
                        <ImageView fitHeight="72.0" fitWidth="140.0" smooth="false">
                            <image>
                                <Image url="@../img/logoMinimalista.jpg" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>

                <Separator />

                <!-- Contenedor de los ToggleButton: se rellena desde NavController según los permisos -->
                <VBox fx:id="vbNav" fillWidth="true" spacing="8.0" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator />

                <Button maxWidth="1.7976931348623157E308" onAction="#abrirPerfil" styleClass="nav-item" text="Perfil">
                    <graphic>
                        <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                            <image>
                                <Image url="@../img/icon_perfil.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button maxWidth="1.7976931348623157E308" onAction="#cerrarSesion" styleClass="nav-item" text="Cerrar sesión">
                    <graphic>
                        <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                            <image>
                                <Image url="@../img/icon_cs.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </VBox>
    </left>
   <stylesheets>
      <URL value="@../css/style.css" />
      <URL value="@../css/theme.css" />
   </stylesheets>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="TOP_RIGHT" prefHeight="26.0" prefWidth="760.0">
               <children>
                  <ImageView fitHeight="30.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/icon_notification.png" />
                     </image>
                  </ImageView>
               </children>
               <padding>
                  <Insets right="20.0" top="20.0" />
               </padding>
            </HBox>
              <StackPane fx:id="contenido" />
         </children>
      </VBox>
   </center>
</BorderPane>
