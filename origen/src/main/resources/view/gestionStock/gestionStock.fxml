<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GestionStockController">
    <center>
        <GridPane vgap="10" BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="44.0" prefHeight="44.0" vgrow="NEVER" />
                <RowConstraints minHeight="-Infinity" vgrow="NEVER" />
                <RowConstraints minHeight="-Infinity" vgrow="NEVER" />
                <RowConstraints minHeight="100.0" vgrow="ALWAYS" />
            </rowConstraints>
            <children>
                <!-- Fila 0: título y botones -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label maxWidth="1.7976931348623157E308" minWidth="-Infinity" styleClass="titulo" text="GESTION DE STOCK" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#registrarPerdida" styleClass="btn-peligro" text="Registrar pérdida" />
                        <Button mnemonicParsing="false" onAction="#añadirProducto" styleClass="btn-primario" text="Añadir stock" />
                    </children>
                </HBox>

                <!-- Fila 1: tarjetas -->
                <GridPane fx:id="gridInfoStock" styleClass="gridStock" GridPane.rowIndex="1">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                    </rowConstraints>
                    <children>
                        <VBox styleClass="stockCajas, cajaVerde">
                            <children>
                                <Label styleClass="stockTitulo" text="Productos" />
                                <Label fx:id="cantProduc" styleClass="stockValor" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="stockCajas, cajaOscura" GridPane.columnIndex="1">
                            <children>
                                <Label styleClass="stockTitulo" text="Valor de stock" />
                                <Label fx:id="precioStock" styleClass="stockValor" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="stockCajas, cajaRoja" GridPane.columnIndex="2">
                            <children>
                                <Label styleClass="stockTitulo" text="Agotados" />
                                <Label fx:id="cantAgotados" styleClass="stockValor" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="stockCajas, cajaAmbar" GridPane.columnIndex="3">
                            <children>
                                <Label styleClass="stockTitulo" text="Stock bajo" />
                                <Label fx:id="cantStockBajo" styleClass="stockValor" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="stockCajas, cajaRoja" GridPane.columnIndex="4">
                            <children>
                                <Label styleClass="stockTitulo" text="Caducan en 7 dias" />
                                <Label fx:id="cantCaducar" styleClass="stockValor" text="0" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- Fila 2: filtros -->
                <GridPane fx:id="gridFiltroStock" hgap="16.0" styleClass="stock-filtros" GridPane.rowIndex="2">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                        <ColumnConstraints hgrow="NEVER" />
                        <ColumnConstraints hgrow="NEVER" />
                        <ColumnConstraints hgrow="NEVER" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints valignment="CENTER" vgrow="NEVER" />
                    </rowConstraints>
                    <children>
                        <HBox styleClass="stock-filtro">
                            <children>
                                <Label text="🔍" />
                                <TextField fx:id="txtBuscar" promptText="Buscar producto" styleClass="stock-buscar" />
                            </children>
                        </HBox>
                        <HBox styleClass="stock-filtro" GridPane.columnIndex="1">
                            <children>
                                <Label styleClass="stock-filtro-label" text="Categoría" />
                                <ComboBox fx:id="categoriaDisplay" prefWidth="150.0" />
                            </children>
                        </HBox>
                        <HBox styleClass="stock-filtro" GridPane.columnIndex="2">
                            <children>
                                <Label styleClass="stock-filtro-label" text="Estado" />
                                <ComboBox fx:id="estadoDisplay" prefWidth="150.0" />
                            </children>
                        </HBox>
                        <ToggleButton fx:id="soloAlertas" mnemonicParsing="false" styleClass="stock-btn-alertas" text="Solo alertas" GridPane.columnIndex="3" />
                    </children>
                </GridPane>

                <!-- Fila 3: tabla -->
                <TableView fx:id="tablaStock" GridPane.rowIndex="3">
                    <columns>
                        <TableColumn fx:id="colProducto" text="Producto" />
                        <TableColumn fx:id="colCategoria" text="Categoria" />
                        <TableColumn fx:id="colExistencia" text="Existencia" />
                        <TableColumn fx:id="colMinimo" text="Minimo" />
                        <TableColumn fx:id="colPrecio" text="Precio" />
                        <TableColumn fx:id="colValor" text="Valor est." />
                        <TableColumn fx:id="colEstado" text="Estado" />
                    </columns>
                </TableView>
            </children>
        </GridPane>
    </center>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</BorderPane>
