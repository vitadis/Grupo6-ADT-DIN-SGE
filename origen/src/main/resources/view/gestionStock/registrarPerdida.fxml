<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane hgap="12" vgap="14" styleClass="ventana, ventanaPerdida" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegistrarPerdidaController">
    <padding>
        <Insets top="30" right="30" bottom="26" left="30" />
    </padding>
    <columnConstraints>
        <ColumnConstraints minWidth="70" prefWidth="70" />
        <ColumnConstraints minWidth="220" prefWidth="220" />
    </columnConstraints>

    <Label fx:id="titulo" styleClass="tituloVentana" text="REGISTRAR PÉRDIDA" GridPane.columnSpan="2" />

    <Label text="Producto:" GridPane.rowIndex="1" />
    <ComboBox fx:id="comboProducto" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Label text="Cantidad:" GridPane.rowIndex="2" />
    <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Label text="Nota:" GridPane.rowIndex="3" GridPane.valignment="TOP">
        <padding>
            <Insets top="7" />
        </padding>
    </Label>
    <TextArea fx:id="txtNota" prefRowCount="4" wrapText="true" promptText="Escribe un resumen de lo sucedido" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <HBox spacing="10" GridPane.columnSpan="2" GridPane.rowIndex="4">
        <padding>
            <Insets top="10" />
        </padding>
        <Button text="Guardar" styleClass="btnPrimario" onAction="#guardarPerdida" />
        <Button text="Cancelar" onAction="#cancelar" />
    </HBox>
</GridPane>