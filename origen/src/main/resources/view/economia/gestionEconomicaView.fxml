<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../../css/theme.css, @../../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GestionEconomicaController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets bottom="0" left="28" right="28" top="14" />
            </padding>
            <TextField fx:id="txtBuscar" prefWidth="320" promptText="Buscar productos, proveedores o ventas..." />
            <Region HBox.hgrow="ALWAYS" />
            <StackPane styleClass="notificaciones" />
            <Label fx:id="lblUsuario" styleClass="texto-secundario" />
            <StackPane styleClass="avatar">
                <Label fx:id="lblAvatar" />
            </StackPane>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets bottom="24" left="28" right="28" top="10" />
            </padding>
            <HBox alignment="BOTTOM_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="texto-secundario" text="Inicio &gt; Gestión económica" />
                    <Label styleClass="titulo" text="Gestión económica" />
                    <Label styleClass="texto-secundario" text="Ingresos, gastos y evolución del negocio" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="BOTTOM_RIGHT" spacing="10">
                    <Button fx:id="btnBalanceMensual" styleClass="btn-secundario" text="Balance mensual" />
                    <Button fx:id="btnRegistrarMovimiento" styleClass="btn-primario" text="Registrar movimiento" />
                </HBox>
            </HBox>
            <HBox spacing="14">
                <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblTituloIngresos" styleClass="texto-secundario" text="Ingresos" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblVariacionIngresos" styleClass="estado-ok" />
                    </HBox>
                    <Label fx:id="lblIngresos" styleClass="titulo" />
                </VBox>

                <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblTituloGastos" styleClass="texto-secundario" text="Gastos" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblVariacionGastos" styleClass="estado-aviso" />
                    </HBox>
                    <Label fx:id="lblGastos" styleClass="titulo" />
                </VBox>

                <VBox spacing="6" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="texto-secundario" text="Beneficio estimado" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblMargen" styleClass="estado-ok" />
                    </HBox>
                    <Label fx:id="lblBeneficio" styleClass="titulo" />
                </VBox>
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="14" styleClass="tarjeta">
                <VBox spacing="4">
                    <Label styleClass="stock-filtro-label" text="Fecha" />
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <DatePicker fx:id="dpDesde" prefWidth="125" promptText="Desde" />
                        <Label styleClass="texto-secundario" text="–" />
                        <DatePicker fx:id="dpHasta" prefWidth="125" promptText="Hasta" />
                    </HBox>
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="stock-filtro-label" text="Tipo" />
                    <ComboBox fx:id="cbTipo" prefWidth="140" promptText="Todos" />
                </VBox>
                <VBox spacing="4">
                    <Label styleClass="stock-filtro-label" text="Categoría" />
                    <ComboBox fx:id="cbCategoria" prefWidth="160" promptText="Todas" />
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="stock-filtro-label" text="Buscar" />
                    <TextField fx:id="txtConcepto" promptText="Concepto..." />
                </VBox>
                <Button fx:id="btnLimpiarFiltros" styleClass="btn-secundario" text="Limpiar filtros" />
            </HBox>
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" styleClass="compras-tabla-cabecera">
                            <Label prefWidth="80" styleClass="texto-secundario" text="Fecha" />
                            <Label prefWidth="220" styleClass="texto-secundario" text="Concepto" />
                            <Label prefWidth="110" styleClass="texto-secundario" text="Categoría" />
                            <Label prefWidth="100" styleClass="texto-secundario" text="Tipo" />
                            <Label alignment="CENTER_RIGHT" prefWidth="110" styleClass="texto-secundario" text="Importe" />
                        </HBox>

                        <ScrollPane fx:id="scrollMovimientos" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                            <VBox fx:id="contenedorMovimientos" spacing="4" styleClass="compras-lista-filas" />
                        </ScrollPane>
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label fx:id="lblContador" styleClass="texto-secundario" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnPaginaAnterior" styleClass="btn-secundario" text="‹" />
                        <Label fx:id="lblPagina" />
                        <Button fx:id="btnPaginaSiguiente" styleClass="btn-secundario" text="›" />
                    </HBox>
                </VBox>
                <VBox maxWidth="360" minWidth="360" prefWidth="360" spacing="14">

                    <VBox spacing="4" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                        <Label styleClass="subtitulo" text="Comparativa de gastos" />
                        <Label styleClass="texto-secundario" text="Gasto mensual en euros (€), últimos 6 meses" />
                        <BarChart fx:id="graficoGastos" animated="false" barGap="0" categoryGap="14" legendVisible="false" styleClass="gestion-grafico" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis fx:id="ejeMeses" side="BOTTOM" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="ejeImporte" side="LEFT" />
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="8" styleClass="gestion-tarjeta-aviso">
                        <Label styleClass="subtitulo" text="▲ Gasto superior a la media" />
                        <Label fx:id="lblTextoAviso" wrapText="true" />
                        <Button fx:id="btnRevisarGastos" styleClass="btn-secundario" text="Revisar gastos por categoría" />
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
